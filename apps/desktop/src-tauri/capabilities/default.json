{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "store:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/NilsBriggen/lemmata/*"
        },
        {
          "url": "https://lemmata.briggen.dev/*"
        },
        {
          "url": "https://*"
        },
        {
          "url": "https://*/*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "http://*/*"
        }
      ]
    },
    "opener:allow-reveal-item-in-dir"
  ]
}
