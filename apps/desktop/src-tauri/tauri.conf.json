{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lemmata",
  "mainBinaryName": "lemmata-app",
  "identifier": "dev.briggen.lemmata",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lemmata",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Local-first LaTeX editor",
    "longDescription": "Lemmata is a LaTeX editor with a live PDF preview and click-to-jump between PDF and source, running on your own TeX Live installation.",
    "copyright": "\u00a9 2026 Nils Briggen. GPL-3.0.",
    "license": "GPL-3.0-only",
    "homepage": "https://lemmata.briggen.dev",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../templates/": "templates/",
      "../../../data/dictionaries/": "dictionaries/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBNTI5M0JBMzY4N0VDOUQKUldTZDdJYzJ1cE5TdWh4c242bDZqdUxFY1VqclFadHZkTkpXMmJEQUYwdEUwSTRQb1N5eVpIdTIK",
      "endpoints": [
        "https://lemmata.briggen.dev/update/latest.json"
      ]
    }
  }
}
